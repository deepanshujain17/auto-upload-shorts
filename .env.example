# Copy to ".env" in this directory (repo root) for local runs:
#   cp .env.example .env
# Then fill in real values. Never commit ".env".

# --- GNews ---
# Required for default / English-style runs (also used as fallback when hi-specific key is unset)
GNEWS_API_KEY=

# Optional: preferred key when running with language "hi" (see README / AGENTS.md)
# GNEWS_HI_API_KEY=

# --- AWS (Polly TTS; boto3 default credential chain) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Logging (optional) ---
# LOG_LEVEL=INFO

# --- YouTube OAuth (files, not env vars) ---
# Place in repo root alongside this .env:
#   client_secrets.json
#   token.pkl          (from: python main.py categories)
#   token_hi.pkl       (optional; when using language hi)
